# Optional local server settings. Copy this file to .env to override defaults.
PORT=3000
DATABASE_PATH=.data/study-timer.sqlite
# Local self-registration defaults to enabled after administrator setup.
# Production defaults to disabled; enable only after reviewing anti-abuse controls.
# REGISTRATION_ENABLED=false
# Local password-reset messages are saved privately instead of emailed.
# RESET_MAIL_DIR=.data/password-reset-mail
# VPS only: set these when running behind the configured reverse proxy.
# HOST=0.0.0.0
# TRUST_PROXY=1
# APP_ORIGIN=https://studytimer.snlynnoo.dev
